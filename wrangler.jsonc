{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aquasite",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aquasite-db",
			// Replace with the real database ID after running:
			// npx wrangler d1 create aquasite-db
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			// Create before deploying: npx wrangler r2 bucket create aquasite-photos
			"bucket_name": "aquasite-photos"
		}
	],
	"vars": {
		// Dev-only placeholder so `npm run dev` and local D1 testing work out
		// of the box. Before deploying for real, override it with a proper
		// secret: npx wrangler secret put SESSION_SECRET
		"SESSION_SECRET": "dev-only-insecure-secret-change-me"
	}
}
